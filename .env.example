# Required: replace the placeholder with the token from Discord Developer Portal.
DISCORD_TOKEN=replace-with-your-discord-bot-token
# Optional providers: uncomment only what you use. These are forwarded by env_file.
# EASYNEWS_ENABLED=true
# EASYNEWS_USERNAME=replace-with-your-username
# EASYNEWS_PASSWORD=replace-with-your-password
# TORBOX_ENABLED=true
# TORBOX_API_KEY=replace-with-your-api-key
# TORBOX_CACHED_ONLY=true
# TMDB_READ_ACCESS_TOKEN=replace-with-your-read-access-token
# TMDB_API_KEY=replace-with-your-v3-api-key
# MUSIC_PROVIDER_PRIORITY=youtube,easynews,torbox
# MUSIC_PROVIDER_TIMEOUT=30
# MUSIC_PROVIDER_COOLDOWN=120
# MUSIC_MATCH_MIN_CONFIDENCE=0.85
# RUST_LOG=info,serenity=warn,songbird=warn,sqlx=warn
# YT_DLP_PATH=yt-dlp
# NO_COLOR=1
